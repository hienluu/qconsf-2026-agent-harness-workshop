# Copy to .env and fill in. python-dotenv loads it automatically in the
# harness scripts and check_setup.py.

# --- Provider (any OpenAI-compatible endpoint; switching = edit these lines) ---
# Baseten (current default):
PROVIDER_BASE_URL=https://inference.baseten.co/v1
# Fireworks alternative:
# PROVIDER_BASE_URL=https://api.fireworks.ai/inference/v1
PROVIDER_API_KEY=

# Model slug from the provider's catalog. Finalized in the pre-workshop
# email; candidates under test: Kimi K2 / Qwen3-Coder / GLM / DeepSeek.
MODEL=

# --- Block 4 only: Anthropic-compatible endpoint for the Claude Agent SDK
# specimens. Bare host (the Anthropic protocol appends /v1/messages itself).
# Baseten:
ANTHROPIC_COMPAT_BASE_URL=https://inference.baseten.co
# Fireworks alternative:
# ANTHROPIC_COMPAT_BASE_URL=https://api.fireworks.ai/inference

# --- Fallback path (presenter rehearsed; attendees can ignore) ---
# ANTHROPIC_API_KEY=
