# Copy to .env and fill in. python-dotenv loads it automatically in the
# harness scripts and check_setup.py.

# --- Provider (any OpenAI-compatible endpoint; switching = edit these lines) ---

# Baseten (current default):
#LLM_BASE_URL="https://inference.baseten.co/v1"
#LLM_API_KEY="<api_key>"
#LLM_MODEL="zai-org/GLM-5.3-Flash"


# Fireworks alternative:
#LLM_BASE_URL=https://api.fireworks.ai/inference/v1
#LLM_API_KEY="<api_key>"
#LLM_MODEL="accounts/fireworks/models/glm-5p3-flash"


# mo settings
#LLM_BASE_URL="https://api.gomomento.ai/v1"
#LLM_API_KEY="<api_key from https://app.gomomento.ai/>"
#LLM_MODEL="momento/zai-org/GLM-5.3-Flash"


